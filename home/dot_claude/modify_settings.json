#!/bin/bash

current_config=$(cat - || echo -n "{}")
if [ -z "$current_config" ]; then
  current_config="{}"
fi

central_config="$(cat "$HOME/git/github/dotfiles-public/home/dot_claude/settings.src.json")"

echo "$current_config" | jq --argjson central "$central_config" '. * $central'
