#!/usr/bin/env bash

set -eufo pipefail

{{- $sudo := "sudo" }}
{{- if eq .chezmoi.username "root" }}
{{-   $sudo = "" }}
{{- end }}

{{- $flavor := "" }}
{{- range $k, $v := $.flavors }}
{{- if has $.chezmoi.osRelease.id $v }}
{{- $flavor = $k }}
{{- end }}
{{- end }}

{{- $pkgs := list }}
{{- range .packages }}
{{- $pkg := coalesce (get . $.chezmoi.osRelease.id) (get . (printf "like_%s" $flavor )) .name }}
{{- if and $pkg (ne $pkg "none") }}
{{-   $pkgs = mustAppend $pkgs $pkg }}
{{- end }}
{{- end }}

# Install repos
{{- if eq $flavor "redhat" }}
{{- range (get .repos $flavor) }}
if [ ! -f /etc/yum.repos.d/{{ .name }}* ]; then
{{ $sudo }} yum-config-manager --add-repo {{ .url }}
fi
{{- end }}
{{ $sudo }} dnf update -y
{{- end }}

# Install packages
{{- if eq $flavor "debian" }}
{{ $sudo }} apt install -y {{ $pkgs | join " " }}

{{- else if eq $flavor "redhat" }}
{{ $sudo }} dnf install -y --allowerasing {{ $pkgs | join " " }}

{{- else if eq $flavor "alpine" }}
{{ $sudo }} apk add {{ $pkgs | join " " }}

{{- end }}
