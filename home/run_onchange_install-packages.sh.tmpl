#!/usr/bin/env bash

set -eufo pipefail

{{ $sudo := "sudo" -}}
{{ if eq .chezmoi.username "root" -}}
{{   $sudo = "" -}}
{{ end -}}

{{ $pkgs := .packages.all -}}

{{ if eq .osid "linux-debian" -}}
{{ $pkgs = concat $pkgs .packages.debian -}}

{{ $sudo }} apt install -y {{ $pkgs | join " " -}}

{{ else if eq .osid "linux-fedora" -}}
{{ $pkgs = concat $pkgs .packages.rhel .packages.fedora -}}

{{ $sudo }} dnf install -y {{ $pkgs | join " " -}}

{{ else if eq .osid "linux-amzn" -}}

{{ $sudo }} dnf install yum-utils spal-release
{{ $sudo }} yum-config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo

{{ $pkgs = concat $pkgs .packages.rhel .packages.amzn -}}

{{ $sudo }} dnf install -y {{ $pkgs | join " " -}}
{{ end }}
