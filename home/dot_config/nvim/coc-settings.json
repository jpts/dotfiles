{
  "diagnostic.checkCurrentLine": true,
  "diagnostic.virtualTextCurrentLineOnly": false,
  "diagnostic.virtualText": true,
  "diagnostic.hintSign": "H",
  "diagnostic.infoSign": "I",
  "diagnostic.errorSign": "E",
  "diagnostic.warningSign": "W",
  "suggest.autoTrigger": "always",
  "suggest.virtualText": true,
  "suggest.enableFloat": true,
  "coc.preferences.formatOnSave": true,
  "coc.preferences.formatOnSaveFiletypes": [
    "go",
    "python",
    "json",
    "terraform"
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": true
  },
  "go.checkForUpdates": "disabled",
  "pylsp.plugins.pycodestyle.maxLineLength": 100,
  "pylsp.plugins.pydocstyle.convention": "google",
  "pylsp.plugins.black.line_length": 100,
  "languageserver": {
    "bash": {
      "command": "bash-language-server",
      "args": [
        "start"
      ],
      "filetypes": [
        "sh"
      ],
      "ignoredRootPaths": []
    },
    "golangci-lint": {
      "command": "golangci-lint-langserver",
      "filetypes": [
        "go"
      ],
      "initializationOptions": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--issues-exit-code=1"
        ]
      }
    },
    "terraform": {
      "command": "terraform-ls",
      "args": [
        "serve"
      ],
      "filetypes": [
        "terraform",
        "tf"
      ],
      "initializationOptions": {},
      "settings": {}
    }
  }
}
